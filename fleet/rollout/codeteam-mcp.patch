+def mcp_config_files(t):
+    """The MCP config files a team's sessions get: the shared mcp.json, then the files the
+    manifest's `mcp_configs` names (a list of paths, relative to codeteam or absolute; any
+    other value is taken as a list of one), in that order. A team switches a server on for itself
+    alone by naming its file there (e.g. CodeGraph: share/mcp-codegraph.json), with that
+    team's own env. An entry that is not a path to an existing file (a missing file, a folder,
+    a number, a ~user that does not exist) is skipped with a warning, so a bad manifest line
+    never stops a session from starting."""
+    files = [MCP_FILE] if MCP_FILE.exists() else []
+    entries = t.m.get("mcp_configs", [])
+    for p in entries if isinstance(entries, list) else [entries]:
+        try:
+            f = Path(p).expanduser()
+            f = f if f.is_absolute() else TOOL_DIR / f
+            ok = bool(str(p).strip()) and f.is_file()
+        except (TypeError, RuntimeError, OSError):
+            ok = False
+        if ok:
+            files.append(f)
+        else:
+            print(f"codeteam: mcp_configs entry {p!r} is not an MCP config file; skipped", file=sys.stderr)
+    return files
+
